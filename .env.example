# Copy this file to .env on the Pi and replace every PASTE-... value.
# Rules: one setting per line, no spaces around "=", no quotation marks.

# Bot token from the Discord Developer Portal (Bot -> Reset Token)
DISCORD_TOKEN=PASTE-BOT-TOKEN-HERE

# Dashboard logins: name:password pairs separated by commas (no commas inside passwords)
DASHBOARD_USERS=admin:PASTE-PASSWORD-HERE,mod:PASTE-OTHER-PASSWORD-HERE

# Any long random text; keeps dashboard logins valid across restarts
DASHBOARD_SECRET=PASTE-LONG-RANDOM-TEXT-HERE

# Discord server ID
GUILD_ID=PASTE-SERVER-ID-HERE

# Channel the bot uploads dashboard images to (Embeds page)
UPLOAD_CHANNEL_ID=PASTE-CHANNEL-ID-HERE

# The forum POST (not the forum) where the bot keeps the roster
ROSTER_CHANNEL_ID=PASTE-ROSTER-POST-ID-HERE

# Staff role(s) that may approve/deny reservations (besides ADMIN_IDS in config.py).
# Several roles: separate with commas, e.g. 111111111111111111,222222222222222222
STAFF_ROLE_IDS=PASTE-STAFF-ROLE-ID-HERE

# Optional, already set in config.py; only add these to change them
# DASHBOARD_PORT=5010
# BOT_API_PORT=5012
# RESERVE_CHANNEL_ID=1574169279601967184
# STAFF_CHANNEL_ID=1574176734520156241
# BOT_SERVICE=idvbot
# DASHBOARD_SERVICE=idvdashboard
# DB_FILE=game_database.db
